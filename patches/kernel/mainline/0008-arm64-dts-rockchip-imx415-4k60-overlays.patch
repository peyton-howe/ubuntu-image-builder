+dtb-$(CONFIG_ARCH_ROCKCHIP) += rk3588-rock-5b-plus-imx415-cam0.dtbo
+dtb-$(CONFIG_ARCH_ROCKCHIP) += rk3588-rock-5b-plus-imx415-cam1.dtbo
+dtb-$(CONFIG_ARCH_ROCKCHIP) += rk3588-rock-5b-plus-imx415-cam0-30fps.dtbo
+dtb-$(CONFIG_ARCH_ROCKCHIP) += rk3588-rock-5b-plus-imx415-cam1-30fps.dtbo
 dtb-$(CONFIG_ARCH_ROCKCHIP) += rk3588-rock-5b-plus-radxa-cam4k-cam0.dtbo
 dtb-$(CONFIG_ARCH_ROCKCHIP) += rk3588-rock-5b-plus-radxa-cam4k-cam1.dtbo
 dtb-$(CONFIG_ARCH_ROCKCHIP) += rk3588-rock-5t.dtb
@@ -336,6 +340,16 @@ dtb-$(CONFIG_ARCH_ROCKCHIP) += rk3588-rock-5b-plus-imx708-cam.dtb

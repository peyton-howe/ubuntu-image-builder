 	rk3588-rock-5b-plus-imx708-cam0.dtbo \
 	rk3588-rock-5b-plus-imx708-cam1.dtbo
+
+dtb-$(CONFIG_ARCH_ROCKCHIP) += rk3588-rock-5b-plus-imx415-cam.dtb
+rk3588-rock-5b-plus-imx415-cam-dtbs := rk3588-rock-5b-plus.dtb \

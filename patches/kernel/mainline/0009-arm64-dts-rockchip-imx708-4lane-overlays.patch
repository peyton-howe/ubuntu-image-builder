From: Peyton Howe <peyton@localhost>
Subject: [PATCH] arm64: dts: rockchip: IMX708 4-lane overlays for ROCK 5B+

4-lane CAM0 and CAM1 overlays with a 549 MHz link frequency. The
existing 2-lane 450 MHz overlays are unchanged.

diff --git a/arch/arm64/boot/dts/rockchip/Makefile b/arch/arm64/boot/dts/rockchip/Makefile
--- a/arch/arm64/boot/dts/rockchip/Makefile
+++ b/arch/arm64/boot/dts/rockchip/Makefile
@@ -208,4 +208,6 @@ dtb-$(CONFIG_ARCH_ROCKCHIP) += rk3588-rock-5b-plus-imx708-cam0.dtbo
 dtb-$(CONFIG_ARCH_ROCKCHIP) += rk3588-rock-5b-plus-imx708-cam1.dtbo
+dtb-$(CONFIG_ARCH_ROCKCHIP) += rk3588-rock-5b-plus-imx708-cam0-4lane.dtbo
+dtb-$(CONFIG_ARCH_ROCKCHIP) += rk3588-rock-5b-plus-imx708-cam1-4lane.dtbo
 dtb-$(CONFIG_ARCH_ROCKCHIP) += rk3588-rock-5b-plus-imx415-cam0.dtbo
 dtb-$(CONFIG_ARCH_ROCKCHIP) += rk3588-rock-5b-plus-imx415-cam1.dtbo
 dtb-$(CONFIG_ARCH_ROCKCHIP) += rk3588-rock-5b-plus-imx415-cam0-30fps.dtbo
@@ -341,5 +343,10 @@ rk3588-rock-5b-plus-imx708-cam-dtbs := rk3588-rock-5b-plus.dtb \
 	rk3588-rock-5b-plus-imx708-cam0.dtbo \
 	rk3588-rock-5b-plus-imx708-cam1.dtbo
+
+dtb-$(CONFIG_ARCH_ROCKCHIP) += rk3588-rock-5b-plus-imx708-4lane-cam.dtb
+rk3588-rock-5b-plus-imx708-4lane-cam-dtbs := rk3588-rock-5b-plus.dtb \
+	rk3588-rock-5b-plus-imx708-cam0-4lane.dtbo \
+	rk3588-rock-5b-plus-imx708-cam1-4lane.dtbo
 
 dtb-$(CONFIG_ARCH_ROCKCHIP) += rk3588-rock-5b-plus-imx415-cam.dtb
 rk3588-rock-5b-plus-imx415-cam-dtbs := rk3588-rock-5b-plus.dtb \
diff --git a/arch/arm64/boot/dts/rockchip/rk3588-rock-5b-plus-imx708-cam0-4lane.dtso b/arch/arm64/boot/dts/rockchip/rk3588-rock-5b-plus-imx708-cam0-4lane.dtso
new file mode 100644
index 000000000..000000000
--- /dev/null
+++ b/arch/arm64/boot/dts/rockchip/rk3588-rock-5b-plus-imx708-cam0-4lane.dtso
@@ -0,0 +1,97 @@
+// SPDX-License-Identifier: (GPL-2.0+ OR MIT)
+/*
+ * Device tree overlay for the IMX708 camera attached to the CAM0 port of
+ * the Radxa ROCK 5B+, using 4 data lanes and a 549 MHz link frequency.
+ */
+
+/dts-v1/;
+/plugin/;
+
+#include <dt-bindings/clock/rockchip,rk3588-cru.h>
+#include <dt-bindings/gpio/gpio.h>
+#include <dt-bindings/pinctrl/rockchip.h>
+
+&{/} {
+	cam0_regulator: cam0_regulator {
+		compatible = "regulator-fixed";
+		regulator-min-microvolt = <1800000>;
+		regulator-max-microvolt = <1800000>;
+		regulator-name = "cam0_regulator";
+		vin-supply = <&vcc_3v3_s3>;
+	};
+};
+
+&i2c3 {
+	#address-cells = <1>;
+	#size-cells = <0>;
+	status = "okay";
+
+	imx708: camera-sensor@1a {
+		compatible = "sony,imx708";
+		reg = <0x1a>;
+		assigned-clocks = <&cru CLK_MIPI_CAMARAOUT_M3>;
+		assigned-clock-rates = <24000000>;
+		clocks = <&cru CLK_MIPI_CAMARAOUT_M3>;
+
+		vdig-supply = <&cam0_regulator>;
+		vana1-supply = <&cam0_regulator>;
+		vana2-supply = <&cam0_regulator>;
+		vddl-supply = <&cam0_regulator>;
+
+		orientation = <2>; /* External */
+
+		pinctrl-names = "default";
+		pinctrl-0 = <&cam0_rstn &mipim0_camera3_clk>;
+		reset-gpios = <&gpio4 RK_PA0 GPIO_ACTIVE_LOW>;
+
+		port {
+			imx708_output: endpoint {
+				data-lanes = <1 2 3 4>;
+				clock-noncontinuous;
+				link-frequencies = /bits/ 64 <549000000>;
+				remote-endpoint = <&csi2_input>;
+			};
+		};
+	};
+};
+
+&pinctrl {
+	cam0 {
+		cam0_rstn: cam0-rstn-pinctrl {
+			rockchip,pins = <4 RK_PA0 RK_FUNC_GPIO &pcfg_pull_none>;
+		};
+	};
+};
+
+&csi2 {
+	status = "okay";
+};
+
+&csi2_in {
+	csi2_input: endpoint {
+		data-lanes = <1 2 3 4>;
+		clock-noncontinuous;
+		link-frequencies = /bits/ 64 <549000000>;
+		remote-endpoint = <&imx708_output>;
+	};
+};
+
+&csi_dphy0 {
+	status = "okay";
+};
+
+&vicap {
+	status = "okay";
+};
+
+&vicap_mmu {
+	status = "okay";
+};
+
+&isp0 {
+	status = "okay";
+};
+
+&isp0_mmu {
+	status = "okay";
+};
diff --git a/arch/arm64/boot/dts/rockchip/rk3588-rock-5b-plus-imx708-cam1-4lane.dtso b/arch/arm64/boot/dts/rockchip/rk3588-rock-5b-plus-imx708-cam1-4lane.dtso
new file mode 100644
index 000000000..000000000
--- /dev/null
+++ b/arch/arm64/boot/dts/rockchip/rk3588-rock-5b-plus-imx708-cam1-4lane.dtso
@@ -0,0 +1,98 @@
+// SPDX-License-Identifier: (GPL-2.0+ OR MIT)
+/*
+ * Device tree overlay for the IMX708 camera attached to the CAM1 port of
+ * the Radxa ROCK 5B+, using 4 data lanes and a 549 MHz link frequency.
+ */
+
+/dts-v1/;
+/plugin/;
+
+#include <dt-bindings/clock/rockchip,rk3588-cru.h>
+#include <dt-bindings/gpio/gpio.h>
+#include <dt-bindings/pinctrl/rockchip.h>
+
+&{/} {
+	cam1_regulator: cam1_regulator {
+		compatible = "regulator-fixed";
+		regulator-min-microvolt = <1800000>;
+		regulator-max-microvolt = <1800000>;
+		regulator-name = "cam1_regulator";
+		vin-supply = <&vcc_3v3_s3>;
+	};
+};
+
+&i2c4 {
+	#address-cells = <1>;
+	#size-cells = <0>;
+	status = "okay";
+
+	cam1_imx708: camera-sensor@1a {
+		compatible = "sony,imx708";
+		reg = <0x1a>;
+		assigned-clocks = <&cru CLK_MIPI_CAMARAOUT_M4>;
+		assigned-clock-rates = <24000000>;
+		clocks = <&cru CLK_MIPI_CAMARAOUT_M4>;
+
+		vdig-supply = <&cam1_regulator>;
+		vana1-supply = <&cam1_regulator>;
+		vana2-supply = <&cam1_regulator>;
+		vddl-supply = <&cam1_regulator>;
+
+		orientation = <2>; /* External */
+
+		pinctrl-names = "default";
+		pinctrl-0 = <&cam1_rstn &mipim0_camera4_clk>;
+		reset-gpios = <&gpio2 RK_PB0 GPIO_ACTIVE_LOW>;
+
+		port {
+			cam1_imx708_output: endpoint {
+				data-lanes = <1 2 3 4>;
+				clock-noncontinuous;
+				link-frequencies = /bits/ 64 <549000000>;
+				remote-endpoint = <&csi4_input>;
+			};
+		};
+	};
+};
+
+&pinctrl {
+	cam1 {
+		cam1_rstn: cam1-rstn-pinctrl {
+			rockchip,pins = <2 RK_PB0 RK_FUNC_GPIO &pcfg_pull_none>;
+		};
+	};
+};
+
+&csi4 {
+	status = "okay";
+};
+
+&csi4_in {
+	csi4_input: endpoint {
+		data-lanes = <1 2 3 4>;
+		clock-noncontinuous;
+		link-frequencies = /bits/ 64 <549000000>;
+		remote-endpoint = <&cam1_imx708_output>;
+	};
+};
+
+&csi_dphy1 {
+	status = "okay";
+};
+
+&vicap {
+	status = "okay";
+};
+
+&vicap_mmu {
+	status = "okay";
+};
+
+/* rkisp2 processes the captured frames; cam0 uses isp0, so cam1 gets isp1. */
+&isp1 {
+	status = "okay";
+};
+
+&isp1_mmu {
+	status = "okay";
+};

#!/usr/bin/make -f

export DH_VERBOSE = 1

VERSION := $(shell dpkg-parsechangelog -S Version | cut -d- -f1)
NAME := rk3588-aic8800
PKG := rk3588-aic8800-dkms
DEST := debian/$(PKG)/usr/src/$(NAME)-$(VERSION)

%:
	dh $@ --with dkms

override_dh_auto_build:
	:

override_dh_auto_install:
	install -d $(DEST)
	cp -a src/aic8800 $(DEST)/aic8800
	cp -a src/aic_btusb $(DEST)/aic_btusb
	cp -a debian/$(PKG).dkms $(DEST)/dkms.conf
	sed -i 's/#MODULE_VERSION#/$(VERSION)/' $(DEST)/dkms.conf
	# Firmware for the driver's USB path (CONFIG_PLATFORM_UBUNTU).
	install -d debian/$(PKG)/lib/firmware/aic8800_fw/USB
	cp -a firmware/. debian/$(PKG)/lib/firmware/aic8800_fw/USB/
	install -d debian/$(PKG)/usr/lib/udev/rules.d
	install -m 0644 files/99-radxa-aic8800.rules \
		debian/$(PKG)/usr/lib/udev/rules.d/99-radxa-aic8800.rules

override_dh_dkms:
	dh_dkms -V $(VERSION)

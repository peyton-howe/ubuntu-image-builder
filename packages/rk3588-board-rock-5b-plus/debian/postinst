#!/bin/sh
set -e

if [ "$1" = configure ]; then
    for k in /boot/vmlinuz-*; do
        [ -f "$k" ] || continue
        /etc/kernel/postinst.d/zz-rk3588-unwrap-kernel "${k#/boot/vmlinuz-}" "$k" || true
    done
    # /etc/flash-kernel/db belongs to flash-kernel, so merge our entry into
    # it between markers instead of shipping the file.
    fkdb=/etc/flash-kernel/db
    mkdir -p /etc/flash-kernel
    touch "$fkdb"
    sed -i '/^# BEGIN rk3588-board-rock-5b-plus$/,/^# END rk3588-board-rock-5b-plus$/d' "$fkdb"
    { echo "# BEGIN rk3588-board-rock-5b-plus"; cat /usr/share/rk3588-board-rock-5b-plus/flash-kernel.db; echo "# END rk3588-board-rock-5b-plus"; } >> "$fkdb"
    frag=/usr/share/rk3588-board-rock-5b-plus/u-boot.default
    target=/etc/default/u-boot
    if [ -f "$frag" ]; then
        mkdir -p /etc/default
        touch "$target"
        # Merge known keys from our fragment
        while IFS= read -r line; do
            case "$line" in
                ''|\#*) continue ;;
            esac
            key=${line%%=*}
            if grep -q "^$key=" "$target"; then
                sed -i "s|^$key=.*|$line|" "$target"
            else
                printf '%s\n' "$line" >> "$target"
            fi
        done < "$frag"
        if command -v u-boot-update >/dev/null; then
            u-boot-update || true
        fi
    fi
    if command -v update-initramfs >/dev/null; then
        update-initramfs -u -k all || true
    fi
fi

#DEBHELPER#

exit 0

#!/usr/bin/make -f
export DH_VERBOSE = 1

PKG := rk3588-board-rock-5b-plus

%:
	dh $@

override_dh_auto_clean:
	rm -rf build/ports

# build/ keeps the sparse kernel checkout between builds.
override_dh_auto_build:
	$(CURDIR)/files/build-ports.sh build/ports build

override_dh_auto_install:
	install -d debian/$(PKG)/usr/share/$(PKG)
	install -m 0644 files/flash-kernel.db debian/$(PKG)/usr/share/$(PKG)/flash-kernel.db
	install -m 0644 files/u-boot.default debian/$(PKG)/usr/share/$(PKG)/u-boot.default
	install -d debian/$(PKG)/usr/share/rk3588-camera/overlays debian/$(PKG)/usr/share/rk3588-camera/boards
	install -m 0644 build/ports/*.dtbo debian/$(PKG)/usr/share/rk3588-camera/overlays/
	install -m 0644 files/camera-board.conf debian/$(PKG)/usr/share/rk3588-camera/boards/rock-5b-plus.conf
	install -d debian/$(PKG)/etc/initramfs-tools/hooks
	install -m 0755 files/initramfs-hook debian/$(PKG)/etc/initramfs-tools/hooks/rk3588-mmc
	install -d debian/$(PKG)/usr/lib/dracut/modules.d/50rk3588-mmc
	install -m 0755 files/dracut-module-setup.sh \
		debian/$(PKG)/usr/lib/dracut/modules.d/50rk3588-mmc/module-setup.sh
	install -d debian/$(PKG)/usr/lib/modules-load.d
	install -m 0644 files/modules-load.conf debian/$(PKG)/usr/lib/modules-load.d/$(PKG).conf
	install -d debian/$(PKG)/usr/lib/udev/rules.d
	install -m 0644 files/panthor-profiling.rules \
		debian/$(PKG)/usr/lib/udev/rules.d/60-rk3588-panthor-profiling.rules
	install -d debian/$(PKG)/etc/kernel/postinst.d
	install -m 0755 files/unwrap-kernel debian/$(PKG)/etc/kernel/postinst.d/zz-rk3588-unwrap-kernel

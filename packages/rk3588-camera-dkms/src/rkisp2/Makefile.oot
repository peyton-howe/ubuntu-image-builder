# Out-of-tree Makefile (rename/merge into Makefile when enabling in dkms.conf).
# In-tree Makefile uses obj-$(CONFIG_VIDEO_ROCKCHIP_ISP2); DKMS always builds.
obj-m += rockchip-isp2.o

rockchip-isp2-y := rkisp2-capture.o \
	rkisp2-common.o \
	rkisp2-dev.o \
	rkisp2-dmarx.o \
	rkisp2-isp.o \
	rkisp2-params.o \
	rkisp2-resizer.o \
	rkisp2-stats.o

# Optional: rockchip-isp2-y += rkisp2-debug.o

ccflags-y += -I$(src)/uapi -I$(src)

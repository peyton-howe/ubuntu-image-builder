/*
 * IMX708 on Orange Pi 5 / 5B CAM3 (Samsung DCPHY1 CSI RX + CSI1).
 */

/dts-v1/;
/plugin/;

#include <dt-bindings/clock/rockchip,rk3588-cru.h>
#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/pinctrl/rockchip.h>

&{/} {
	cam3_regulator: cam3_regulator {
		compatible = "regulator-fixed";
		regulator-name = "cam3_regulator";
		regulator-min-microvolt = <1800000>;
		regulator-max-microvolt = <1800000>;
		vin-supply = <&vcc_3v3_s3>;
	};
};

&i2c2 {
	#address-cells = <1>;
	#size-cells = <0>;
	clock-frequency = <400000>;
	status = "okay";

	imx708: camera-sensor@1a {
		compatible = "sony,imx708";
		reg = <0x1a>;
		assigned-clocks = <&cru CLK_MIPI_CAMARAOUT_M4>;
		assigned-clock-rates = <24000000>;
		clocks = <&cru CLK_MIPI_CAMARAOUT_M4>;
		vdig-supply = <&cam3_regulator>;
		vana1-supply = <&cam3_regulator>;
		vana2-supply = <&cam3_regulator>;
		vddl-supply = <&cam3_regulator>;
		orientation = <2>;
		pinctrl-names = "default";
		pinctrl-0 = <&cam3_rstn &mipim0_camera4_clk>;
		reset-gpios = <&gpio1 RK_PA6 GPIO_ACTIVE_HIGH>;
		port {
			imx708_output: endpoint {
				data-lanes = <1 2>;
				clock-noncontinuous;
				link-frequencies = /bits/ 64 <450000000>;
				remote-endpoint = <&csi1_input>;
			};
		};
	};
};

&pinctrl {
	cam3 {
		cam3_rstn: cam3-rstn-pinctrl {
			rockchip,pins = <1 RK_PA6 RK_FUNC_GPIO &pcfg_pull_none>;
		};
	};
};

&csi1 {
	status = "okay";
};

&csi1_in {
	csi1_input: endpoint {
		data-lanes = <1 2>;
		clock-noncontinuous;
		link-frequencies = /bits/ 64 <450000000>;
		remote-endpoint = <&imx708_output>;
	};
};

&vicap {
	status = "okay";
};

&vicap_mmu {
	status = "okay";
};

&isp0 {
	status = "okay";
};

&isp0_mmu {
	status = "okay";
};

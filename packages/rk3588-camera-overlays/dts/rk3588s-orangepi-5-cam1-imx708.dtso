/*
 * IMX708 on Orange Pi 5 / 5B CAM1 (Inno CSI D-PHY + CSI2).
 */

/dts-v1/;
/plugin/;

#include <dt-bindings/clock/rockchip,rk3588-cru.h>
#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/pinctrl/rockchip.h>

&{/} {
	cam1_regulator: cam1_regulator {
		compatible = "regulator-fixed";
		regulator-name = "cam1_regulator";
		regulator-min-microvolt = <1800000>;
		regulator-max-microvolt = <1800000>;
		vin-supply = <&vcc_3v3_s3>;
	};
};

&i2c7 {
	#address-cells = <1>;
	#size-cells = <0>;
	clock-frequency = <400000>;
	pinctrl-names = "default";
	pinctrl-0 = <&i2c7m0_xfer>;
	status = "okay";

	imx708: camera-sensor@1a {
		compatible = "sony,imx708";
		reg = <0x1a>;
		assigned-clocks = <&cru CLK_MIPI_CAMARAOUT_M3>;
		assigned-clock-rates = <24000000>;
		clocks = <&cru CLK_MIPI_CAMARAOUT_M3>;
		vdig-supply = <&cam1_regulator>;
		vana1-supply = <&cam1_regulator>;
		vana2-supply = <&cam1_regulator>;
		vddl-supply = <&cam1_regulator>;
		orientation = <2>;
		pinctrl-names = "default";
		pinctrl-0 = <&cam1_rstn &mipim0_camera3_clk>;
		reset-gpios = <&gpio3 RK_PC4 GPIO_ACTIVE_HIGH>;
		port {
			imx708_output: endpoint {
				data-lanes = <1 2>;
				clock-noncontinuous;
				link-frequencies = /bits/ 64 <450000000>;
				remote-endpoint = <&csi2_input>;
			};
		};
	};
};

&pinctrl {
	cam1 {
		cam1_rstn: cam1-rstn-pinctrl {
			rockchip,pins = <3 RK_PC4 RK_FUNC_GPIO &pcfg_pull_none>;
		};
	};
};

&csi2 {
	status = "okay";
};

&csi2_in {
	csi2_input: endpoint {
		data-lanes = <1 2>;
		clock-noncontinuous;
		link-frequencies = /bits/ 64 <450000000>;
		remote-endpoint = <&imx708_output>;
	};
};

&csi_dphy0 {
	status = "okay";
};

&vicap {
	status = "okay";
};

&vicap_mmu {
	status = "okay";
};

&isp0 {
	status = "okay";
};

&isp0_mmu {
	status = "okay";
};

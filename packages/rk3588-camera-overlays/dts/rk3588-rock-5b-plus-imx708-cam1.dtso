/*
 * Device tree overlay for the IMX708 camera attached to the CAM1 port of
 * the Radxa ROCK 5B+.
 */

/dts-v1/;
/plugin/;

#include <dt-bindings/clock/rockchip,rk3588-cru.h>
#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/pinctrl/rockchip.h>

&{/} {
	cam1_regulator: cam1_regulator {
		compatible = "regulator-fixed";
		regulator-min-microvolt = <1800000>;
		regulator-max-microvolt = <1800000>;
		regulator-name = "cam1_regulator";
		vin-supply = <&vcc_3v3_s3>;
	};
};

&i2c4 {
	#address-cells = <1>;
	#size-cells = <0>;
	status = "okay";

	cam1_imx708: camera-sensor@1a {
		compatible = "sony,imx708";
		reg = <0x1a>;
		assigned-clocks = <&cru CLK_MIPI_CAMARAOUT_M4>;
		assigned-clock-rates = <24000000>;
		clocks = <&cru CLK_MIPI_CAMARAOUT_M4>;

		vdig-supply = <&cam1_regulator>;
		vana1-supply = <&cam1_regulator>;
		vana2-supply = <&cam1_regulator>;
		vddl-supply = <&cam1_regulator>;

		orientation = <2>; /* External */

		pinctrl-names = "default";
		pinctrl-0 = <&cam1_rstn &mipim0_camera4_clk>;
		reset-gpios = <&gpio2 RK_PB0 GPIO_ACTIVE_LOW>;

		port {
			cam1_imx708_output: endpoint {
				data-lanes = <1 2>;
				clock-noncontinuous;
				link-frequencies = /bits/ 64 <450000000>;
				remote-endpoint = <&csi4_input>;
			};
		};
	};
};

&pinctrl {
	cam1 {
		cam1_rstn: cam1-rstn-pinctrl {
			rockchip,pins = <2 RK_PB0 RK_FUNC_GPIO &pcfg_pull_none>;
		};
	};
};

&csi4 {
	status = "okay";
};

&csi4_in {
	csi4_input: endpoint {
		data-lanes = <1 2>;
		clock-noncontinuous;
		link-frequencies = /bits/ 64 <450000000>;
		remote-endpoint = <&cam1_imx708_output>;
	};
};

&csi_dphy1 {
	status = "okay";
};

&vicap {
	status = "okay";
};

&vicap_mmu {
	status = "okay";
};

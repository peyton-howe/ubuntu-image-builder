/*
 * Orange Pi 5 / 5B CAM2 (port2): Samsung DCPHY0 CSI RX + CSI0 on i2c7.
 *
 * Publishes cam_port2_sensor, cam_port2_sensor_ep, cam_port2_csi_ep,
 * and cam_port2_reg. Shares i2c7 with port1, so the sensor node is named
 * camera-port2. The DCPHY receiver still needs the patched
 * phy-rockchip-samsung-dcphy; this overlay does not enable that PHY.
 */

/dts-v1/;
/plugin/;

#include <dt-bindings/clock/rockchip,rk3588-cru.h>
#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/pinctrl/rockchip.h>

&{/} {
	cam_port2_reg: cam-port2-regulator {
		compatible = "regulator-fixed";
		regulator-name = "cam-port2-regulator";
		regulator-min-microvolt = <1800000>;
		regulator-max-microvolt = <1800000>;
		vin-supply = <&vcc_3v3_s3>;
	};
};

&i2c7 {
	#address-cells = <1>;
	#size-cells = <0>;
	clock-frequency = <400000>;
	pinctrl-names = "default";
	pinctrl-0 = <&i2c7m0_xfer>;
	status = "okay";

	cam_port2_sensor: camera-port2 {
		status = "disabled";
		assigned-clocks = <&cru CLK_MIPI_CAMARAOUT_M4>;
		assigned-clock-rates = <24000000>;
		clocks = <&cru CLK_MIPI_CAMARAOUT_M4>;
		pinctrl-names = "default";
		pinctrl-0 = <&cam2_rstn &mipim0_camera4_clk>;
		reset-gpios = <&gpio1 RK_PB2 GPIO_ACTIVE_HIGH>;

		port {
			cam_port2_sensor_ep: endpoint {
				remote-endpoint = <&cam_port2_csi_ep>;
				data-lanes = <1 2>;
				clock-noncontinuous;
				link-frequencies = /bits/ 64 <450000000>;
			};
		};
	};
};

&pinctrl {
	cam2 {
		cam2_rstn: cam2-rstn-pinctrl {
			rockchip,pins = <1 RK_PB2 RK_FUNC_GPIO &pcfg_pull_none>;
		};
	};
};

&csi0 {
	status = "okay";
};

&csi0_in {
	cam_port2_csi_ep: endpoint {
		remote-endpoint = <&cam_port2_sensor_ep>;
		data-lanes = <1 2>;
		clock-noncontinuous;
		link-frequencies = /bits/ 64 <450000000>;
	};
};

&vicap {
	status = "okay";
};

&vicap_mmu {
	status = "okay";
};
